// Grafana Alloy: scrape node_exporter on both Droplets over the VPC and
// push the samples to Grafana Cloud.
// Remote_write URL and instance ID are filled in below; the token lives in a Docker secret.

prometheus.scrape "nodes" {
  targets = [
    { "__address__" = "10.118.0.2:9100", "instance" = "ece1779-swarm-manager" },
    { "__address__" = "10.118.0.3:9100", "instance" = "ece1779-swarm-worker" },
  ]
  job_name        = "node"
  scrape_interval = "30s"
  forward_to      = [prometheus.relabel.keep_basic.receiver]
}

// Keep only the metric families the Node Exporter Full dashboard needs for
// CPU, memory, disk, network and load, to stay well under the 10k-series free tier.
prometheus.relabel "keep_basic" {
  rule {
    source_labels = ["__name__"]
    regex         = "up|node_(cpu_seconds_total|memory_.*|load[0-9]+|filesystem_.*|disk_.*|network_(receive|transmit)_.*|time_seconds|boot_time_seconds|uname_info|os_info|procs_.*|context_switches_total|intr_total|vmstat_.*|netstat_.*|sockstat_.*|scrape_collector_.*)"
    action        = "keep"
  }
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = "https://prometheus-prod-32-prod-ca-east-0.grafana.net/api/prom/push"
    basic_auth {
      username      = "3788034"
      password_file = "/run/secrets/grafana_cloud_token"
    }
  }
}
